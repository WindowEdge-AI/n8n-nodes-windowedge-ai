{
	"name": "@windowedge/n8n-nodes-windowedge-ai",
	"version": "0.1.0",
	"description": "n8n community node for WindowEdge AI lead ingestion",
	"license": "MIT",
	"homepage": "https://github.com/WindowEdge-AI/n8n-nodes-windowedge-ai#readme",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"windowedge",
		"windowedge-ai",
		"lead-ingestion",
		"home-services"
	],
	"author": {
		"name": "WindowEdge AI"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/WindowEdge-AI/n8n-nodes-windowedge-ai.git"
	},
	"bugs": {
		"url": "https://github.com/WindowEdge-AI/n8n-nodes-windowedge-ai/issues"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "npm run lint && npm test",
		"test": "npm run build && node --test tests/*.test.cjs"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/WindowEdgeAiApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/WindowEdgeAi/WindowEdgeAi.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "0.35.0",
		"eslint": "9.29.0",
		"n8n-workflow": "2.16.0",
		"prettier": "3.8.3",
		"release-it": "20.2.0",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"engines": {
		"node": ">=20.19"
	}
}
